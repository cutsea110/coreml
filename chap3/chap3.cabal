cabal-version:      3.0
name:               chap3
version:            0.1.0.0
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    exposed-modules:  ReadString
    build-depends:    base, containers
    hs-source-dirs:   readstring
    default-language: Haskell2010
    ghc-options:      -Wall
executable chap3
    import:           warnings
    main-is:          Main.hs
    other-modules:    Top
    build-depends:    base, chap3
    hs-source-dirs:   main
    default-language: Haskell2010
