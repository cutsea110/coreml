cabal-version:      3.0
name:               compiler
version:            0.1.0.0
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    exposed-modules:  CoreMLLex
                      Token
                      Lexer
                      Parser
    build-depends:    base, containers
    hs-source-dirs:   lex
    default-language: Haskell2010
    ghc-options:      -Wall
executable cmlc
    import:           warnings
    main-is:          Main.hs
    other-modules:    Top
    build-depends:    base, compiler
    hs-source-dirs:   main
    default-language: Haskell2010
