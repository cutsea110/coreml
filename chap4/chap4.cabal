cabal-version:      3.0
name:               chap4
version:            0.1.0.0
homepage:           https://github.com/cutsea110/coreml.git
license:            BSD-3-Clause
license-file:       LICENSE
author:             cutsea110
maintainer:         cutsea110@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
common warnings
    ghc-options: -Wall
library
    exposed-modules:  DFA
    build-depends:    base, containers
    hs-source-dirs:   src
    default-language: GHC2024
    ghc-options:      -Wall
executable chap4
    import:           warnings
    main-is:          Main.hs
    build-depends:    base, chap4
    hs-source-dirs:   app
    default-language: GHC2024
    ghc-options:      -Wall

test-suite doctest
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Doctest.hs
    build-depends:    base ^>=4.22.0.0, doctest, directory, filepath
    hs-source-dirs:   test
    default-language: GHC2024
